---
// Shared page shell (faz-1 §2 task 5); head metadata via Seo (faz-4 §2 task 1).
import '@/styles/global.css';

import Seo from '@/components/layout/Seo.astro';
import SiteFooter from '@/components/layout/SiteFooter.astro';
import SiteHeader from '@/components/layout/SiteHeader.astro';
import SkipLink from '@/components/layout/SkipLink.astro';
import { site } from '@/data/site';
import { absoluteUrl, pageTitle, type JsonLd } from '@/lib/seo';
import { themeScript } from '@/lib/theme';

interface Props {
  /** Page name; rendered as "{title} · Ulaşcan Ertürk". Omit on the home page. */
  title?: string;
  description?: string;
  /** Excludes the page from search engines (e.g. 404); no canonical is emitted. */
  noindex?: boolean;
  /** Open Graph type: `article` for project pages. */
  ogType?: 'website' | 'article';
  /** Share image (path or URL); defaults to `site.ogImage`. */
  image?: { src: string; width: number; height: number; alt: string };
  jsonLd?: JsonLd;
}

const {
  title,
  description = site.description,
  noindex = false,
  ogType = 'website',
  image = { ...site.ogImage, src: site.ogImage.path },
  jsonLd,
} = Astro.props;

const siteUrl = Astro.site ?? site.url;
const canonical = noindex ? undefined : absoluteUrl(Astro.url.pathname, siteUrl);
const mainId = 'icerik';
---

<!doctype html>
<html lang={site.lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <Seo
      title={pageTitle(title, site.name, site.titleSeparator)}
      description={description}
      canonical={canonical}
      noindex={noindex}
      siteName={site.name}
      locale={site.locale}
      type={ogType}
      image={{ ...image, url: absoluteUrl(image.src, siteUrl) }}
      jsonLd={jsonLd}
    />
    <meta name="color-scheme" content="light dark" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <script is:inline set:html={themeScript} />
  </head>
  <body>
    <SkipLink label={site.skipLink} target={mainId} />
    <SiteHeader
      siteName={site.name}
      navLabel={site.nav.label}
      items={site.nav.items}
      currentPath={Astro.url.pathname}
      themeToggleLabel={site.themeToggleLabel}
    />
    <main id={mainId} tabindex="-1" class="site-main">
      <slot />
    </main>
    <SiteFooter
      label={site.footer.label}
      copyrightHolder={site.footer.copyrightHolder}
      links={site.footer.links}
    />
  </body>
</html>

<style>
  .site-main {
    width: min(100% - 2 * var(--space-s), var(--container));
    margin-inline: auto;
    padding-block: var(--space-xl);
  }

  .site-main:focus {
    outline: none;
  }

  .site-main :global(p) {
    max-width: var(--measure);
  }

  .site-main > :global(* + *) {
    margin-top: var(--space-s);
  }
</style>
