---
// Profile page (faz-2 §2 task 6). Sections follow plans/02-icerik-ve-tasarim.md
// §2–§3; data and text come from src/data/profile.ts (ulascanerturk.md).
// "Öne çıkan projeler" (#projeler, faz-3 §2 task 8) lists the `featured` entries.
import { getCollection } from 'astro:content';

import EcosystemNote from '@/components/profile/EcosystemNote.astro';
import EducationList from '@/components/profile/EducationList.astro';
import ExperienceList from '@/components/profile/ExperienceList.astro';
import FocusAreas from '@/components/profile/FocusAreas.astro';
import LinkList from '@/components/profile/LinkList.astro';
import ProfileHero from '@/components/profile/ProfileHero.astro';
import ProjectCard from '@/components/projects/ProjectCard.astro';
import SkillsGrid from '@/components/profile/SkillsGrid.astro';
import WorkAreas from '@/components/profile/WorkAreas.astro';
import Callout from '@/components/ui/Callout.astro';
import Section from '@/components/ui/Section.astro';
import { profile, profilePage } from '@/data/profile';
import { projectsPage } from '@/data/projects';
import BaseLayout from '@/layouts/BaseLayout.astro';
import { formatDate } from '@/lib/date';
import { isPublished, sortProjects } from '@/lib/projects';

const { about, skills, experience, projects, education, ecosystem, focusAreas, links, footnote } =
  profilePage;

const heroActions = profilePage.hero.actions.flatMap((action) => {
  if ('href' in action) return [{ label: action.label, href: action.href, external: false }];
  const link = profile.links.find((candidate) => candidate.kind === action.kind);
  return link ? [{ label: action.label, href: link.url, external: true }] : [];
});

const featured = sortProjects(
  await getCollection(
    'projects',
    ({ data }) => data.featured && isPublished(data, import.meta.env.PROD),
  ),
);
---

<BaseLayout description={profilePage.description}>
  <ProfileHero
    name={profile.name}
    headline={profile.headline}
    location={profile.location}
    tagline={profile.tagline}
    actions={heroActions}
  />

  <Section id={about.id} title={about.title}>
    {profile.summary.map((paragraph) => (
      <p>{paragraph}</p>
    ))}
  </Section>

  <Section id={skills.id} title={skills.title}>
    <p>{skills.intro}</p>
    <SkillsGrid groups={profile.skills} />
  </Section>

  <Section id={experience.id} title={experience.title}>
    <ExperienceList items={profile.experience} problemsLabel={experience.problemsLabel} />
    <WorkAreas
      title={experience.workAreasTitle}
      items={profile.workAreas.items}
      note={profile.workAreas.note}
    />
    <Callout>{experience.note}</Callout>
  </Section>

  <Section id={projects.id} title={projects.title}>
    <div class="featured-projects">
      {featured.map((project) => (
        <ProjectCard
          title={project.data.title}
          href={`/projeler/${project.id}/`}
          summary={project.data.summary}
          statusLabel={projectsPage.statusLabels[project.data.status]}
          tech={project.data.tech}
          techLabel={projectsPage.techLabel}
          level={3}
        />
      ))}
    </div>
    <p>
      <a href="/projeler/" class="featured-projects__all">
        {projects.allLabel}
      </a>
    </p>
  </Section>

  <Section id={education.id} title={education.title}>
    <EducationList
      items={profile.education}
      groups={education.groups}
      kindLabels={education.kindLabels}
      note={education.note}
    />
  </Section>

  <Section id={ecosystem.id} title={ecosystem.title}>
    <p>{ecosystem.intro}</p>
    <EcosystemNote
      context={profile.ecosystem.context}
      programs={profile.ecosystem.programs}
      note={profile.ecosystem.note}
    />
  </Section>

  <Section id={focusAreas.id} title={focusAreas.title}>
    <FocusAreas items={profile.focusAreas} />
  </Section>

  <Section id={links.id} title={links.title}>
    <LinkList links={profile.links} />
  </Section>

  <div class="profile-footnote">
    <p>{footnote.text}</p>
    <p>
      {footnote.updatedLabel}
      <time datetime={profile.lastUpdated}>{formatDate(profile.lastUpdated)}</time>
    </p>
  </div>
</BaseLayout>

<style>
  .featured-projects {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 18rem), 1fr));
    gap: var(--space-m);
  }

  .featured-projects__all {
    display: inline-flex;
    align-items: center;
    min-height: var(--tap-target);
  }

  .profile-footnote {
    margin-top: var(--space-xl);
    padding-top: var(--space-s);
    border-top: 1px solid var(--color-border);
    color: var(--color-text-muted);
    font-size: var(--step--1);
  }
</style>
