---
// English project documents (/en/projects/{slug}/{privacy|support|security}/) — ADR-014.
import { render } from 'astro:content';

import ProjectDocLayout from '@/layouts/ProjectDocLayout.astro';
import {
  projectDocLayoutProps,
  projectDocPaths,
  type ProjectDocPageProps,
} from '@/pages/_shared/projectDocs';

export function getStaticPaths() {
  return projectDocPaths('en');
}

type Props = ProjectDocPageProps;

const { Content } = await render(Astro.props.entry);
const props = projectDocLayoutProps(Astro.props, 'en');
---

<ProjectDocLayout {...props}>
  <Content />
</ProjectDocLayout>
