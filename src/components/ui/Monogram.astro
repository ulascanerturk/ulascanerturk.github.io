---
// "UE" monogram avatar (S3: no photo). Same drawing as public/favicon.svg.
// With `label` it is an image (role="img"); without it, it is decorative —
// e.g. next to the visible name in the header.
interface Props {
  label?: string;
  size?: number;
}

const { label, size = 64 } = Astro.props;
---

<svg
  class="monogram"
  viewBox="0 0 64 64"
  width={size}
  height={size}
  role={label ? 'img' : undefined}
  aria-label={label}
  aria-hidden={label ? undefined : 'true'}
  focusable="false"
>
  <circle cx="32" cy="32" r="32" class="monogram__bg"></circle>
  <path
    class="monogram__letters"
    d="M16 21V36a7 7 0 0 0 14 0V21M48 21H37V43H48M37 32H46"
    fill="none"
    stroke-width="4"
  ></path>
</svg>

<style>
  .monogram {
    flex-shrink: 0;
  }

  .monogram__bg {
    fill: var(--color-accent);
  }

  .monogram__letters {
    stroke: var(--color-accent-contrast);
  }
</style>
