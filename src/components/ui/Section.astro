---
// Page section with a heading and an `id` anchor (e.g. /#hakkimda).
interface Props {
  id: string;
  title: string;
  level?: 2 | 3;
}

const { id, title, level = 2 } = Astro.props;
const Heading = `h${level}` as const;
const headingId = `${id}-baslik`;
---

<section id={id} aria-labelledby={headingId} class="section">
  <Heading id={headingId} class="section__title">
    {title}
  </Heading>
  <slot />
</section>

<style>
  .section {
    scroll-margin-top: var(--space-m);
    display: flex;
    flex-direction: column;
    gap: var(--space-s);
  }

  .section + :global(.section) {
    margin-top: var(--space-xl);
  }
</style>
